{
  "name": "music_player",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/kill-port.mjs 5173",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:extension": "tsc && vite build --mode extension",
    "preview": "vite preview",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "node --test \"tests/e2e/*.test.ts\"",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.43",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@soundtouchjs/audio-worklet": "^2.1.1",
    "@soundtouchjs/core": "^2.1.1"
  }
}
